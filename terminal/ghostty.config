# Ghostty — macOS terminal (linked to ~/.config/ghostty/config by dotbot).
# tmux owns sessions/layouts; Ghostty owns rendering, clipboard, notifications.
# Defaults are deliberately trusted (bell badge/bounce, Metal renderer) —
# only deviations live here.

# Left Option = terminal Alt for shell/tmux; right Option stays macOS-native
# so German-layout symbols (@, ~, [, ]) keep working.
macos-option-as-alt = left

font-family = JetBrainsMono Nerd Font
font-size = 13

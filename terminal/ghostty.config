# Ghostty — macOS terminal (linked to ~/.config/ghostty/config by dotbot).
# tmux owns sessions/layouts; Ghostty owns rendering, clipboard, notifications.
# Defaults are deliberately trusted (bell badge/bounce, Metal renderer) —
# only deviations live here.

# Left Option = terminal Alt for shell/tmux; right Option stays macOS-native
# so German-layout symbols (@, ~, [, ]) keep working.
macos-option-as-alt = left

font-family = JetBrainsMono Nerd Font
font-size = 13

# Mouse selection goes straight to the system clipboard (paste = Cmd+V).
# cmux has its own equivalent (terminal.copyOnSelect) in ~/.config/cmux/cmux.json.
copy-on-select = clipboard

# Darcula palette carried over from the Windows Terminal setup
# (terminal/settings.json "Darcula" scheme) — JetBrains-style, with the
# personal tweak of orange in the ANSI blue slots (4/12) instead of blue.
# cmux reads this file too, so both terminals stay in sync.
background = #2B2B2B
foreground = #A9B7C6
cursor-color = #FFFFFF
selection-background = #214283
palette = 0=#0C0C0C
palette = 1=#C4423E
palette = 2=#79AD72
palette = 3=#C19C00
palette = 4=#E68738
palette = 5=#881798
palette = 6=#3A96DD
palette = 7=#CCCCCC
palette = 8=#808080
palette = 9=#BC3F3C
palette = 10=#5E8759
palette = 11=#DCC457
palette = 12=#CC7832
palette = 13=#85678F
palette = 14=#299999
palette = 15=#A9B7C6

[include]
	path = ~/.gitconfig.local
[user]
	name = clemens33
	email = clemens.kr@gmail.com
[core]
	autocrlf = input
	pager = delta
	untrackedCache = true
# Large-repo speed. On git >= 2.40 manyFiles turns on index.skipHash (no trailing index
# checksum), index.version=4 (path-prefix compression) and core.untrackedCache. Version 4
# applies only to new indexes: an existing repo keeps v2 until
# `git update-index --index-version 4`. skipHash and the untracked cache apply on the next
# index write. No core.fsmonitor: the built-in daemon is per repo and costs a process each.
[feature]
	manyFiles = true
[credential]
	helper = cache --timeout=86400
[init]
	defaultBranch = main
[credential "https://github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
# The work includes MUST stay below the credential blocks above. `helper =` with an empty
# value resets the helper chain, so an include placed earlier has its helper silently
# wiped by line 30 and every mic-cust push falls back to the active gh account.
[includeIf "gitdir:~/projects/mic/"]
    path = ~/.gitconfig-mic
# A mic-cust clone outside ~/projects/mic/ (e.g. ~/.gitleaks, the pre-push hook's config
# repo) is not covered by the gitdir rule above, so match on the remote instead and give
# it the same work identity and account-pinned credential helper. Needs git >= 2.36.
[includeIf "hasconfig:remote.*.url:https://github.com/mic-cust/**"]
    path = ~/.gitconfig-mic-github
[includeIf "hasconfig:remote.*.url:https://github.com/mic-cust-copilot/**"]
    path = ~/.gitconfig-mic-github
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	side-by-side = true
	line-numbers = true
	dark = true
	syntax-theme = DarkNeon
[merge]
	conflictStyle = zdiff3

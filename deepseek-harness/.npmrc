# Project-local lifecycle-script guard for the DeepSeek Harness runtime.
#
# This file is COPIED into the runtime prefix (~/.local/share/dsh) beside
# package.json and package-lock.json, so `npm ci` there is guarded by this
# tracked policy rather than by whatever ~/.npmrc happens to say. Proof, run
# from the runtime directory:
#
#   npm config get strict-allow-scripts --userconfig /dev/null   -> true
#
# The allow/deny decisions themselves live in package.json: npm's .npmrc
# `allow-scripts[]` list can only ever ALLOW (the resolver builds {name:true}),
# and a DENY is expressible only as a package.json `allowScripts` boolean.
strict-allow-scripts=true

#!/bin/sh

set -eu

PROGRAM=${0##*/}
CONFIG_DIR=$HOME/.config/open-design
COMPOSE_FILE=$CONFIG_DIR/compose.yaml
DOCKERFILE=$CONFIG_DIR/Dockerfile
CONTAINER=open-design
DAEMON_URL=http://127.0.0.1:7456
CLI_PATH=apps/daemon/dist/cli.js
# Persistent, volume-backed storage inside the container. A local install is a
# symlink from the catalog directory into a source directory, so the source has
# to outlive the temp dir the package arrives in.
SOURCES_DIR=/app/.od/design-system-sources
CATALOG_DIR=/app/.od/design-systems
SYNC_MARKER=.open-design-sync.json
import_tmp=
sync_tmp=
sync_backup=
sync_id=
sync_lock=
sync_link_created=
mcp_pid=

fail() {
    printf '%s: %s\n' "$PROGRAM" "$*" >&2
    exit 1
}

need_command() {
    command -v "$1" >/dev/null 2>&1 || fail "required command not found: $1"
}

require_docker() {
    need_command docker
    docker info >/dev/null 2>&1 || fail "Docker daemon is unavailable"
}

require_compose() {
    [ -f "$COMPOSE_FILE" ] || fail "Compose file not found: $COMPOSE_FILE (run ./install from the dotfiles checkout)"
    require_docker
    docker compose version >/dev/null 2>&1 || fail "Docker Compose plugin is unavailable"
}

compose() {
    require_compose
    docker compose \
        --project-directory "$CONFIG_DIR" \
        -f "$COMPOSE_FILE" \
        "$@"
}

require_running_container() {
    require_docker
    running=$(docker inspect --format '{{.State.Running}}' "$CONTAINER" 2>/dev/null) ||
        fail "container $CONTAINER does not exist; run open-design start"
    [ "$running" = true ] || fail "container $CONTAINER is not running; run open-design start"
}

build_image() {
    [ -f "$DOCKERFILE" ] ||
        fail "Dockerfile not found: $DOCKERFILE (run ./install from the dotfiles checkout)"
    # Compose owns the image name so the tag cannot drift between these files.
    image=$(compose config --images) || fail "cannot read the service image name"
    case $image in
        '' | *[!0-9A-Za-z._:/-]*)
            fail "unexpected service image name in $COMPOSE_FILE: $image"
            ;;
    esac
    # A Docker build context does not follow the Dotbot symlink that installs
    # this Dockerfile, and pointing the context at the dotfiles checkout would
    # ship the whole repo to the daemon. The Dockerfile is COPY-free, so it goes
    # in on stdin and the build runs with no context at all.
    docker build --tag "$image" - < "$DOCKERFILE"
}

run_cli() {
    require_running_container
    exec docker exec -i "$CONTAINER" node "$CLI_PATH" "$@" --daemon-url "$DAEMON_URL"
}

mcp_signal() {
    signal=$1
    code=$2
    trap - HUP INT TERM
    if [ -n "$mcp_pid" ]; then
        kill -"$signal" "$mcp_pid" 2>/dev/null || :
        wait "$mcp_pid" 2>/dev/null || :
    fi
    exit "$code"
}

run_mcp_bridge() {
    trap 'mcp_signal HUP 129' HUP
    trap 'mcp_signal INT 130' INT
    trap 'mcp_signal TERM 143' TERM
    docker exec -i "$CONTAINER" node "$CLI_PATH" mcp --daemon-url "$DAEMON_URL" <&0 &
    mcp_pid=$!
    if wait "$mcp_pid"; then
        status=0
    else
        status=$?
    fi
    mcp_pid=
    trap - HUP INT TERM
    return "$status"
}

cleanup_import() {
    case $import_tmp in
        /tmp/open-design-import.*)
            docker exec "$CONTAINER" rm -rf "$import_tmp" >/dev/null 2>&1 || :
            ;;
    esac
    import_tmp=
}

import_design_system() {
    [ "$#" -ge 1 ] || fail "usage: open-design import-design-system <host-dir> [OpenDesign import args]"
    host_dir=$1
    shift
    [ -n "$host_dir" ] || fail "design-system path must not be empty"
    [ -d "$host_dir" ] || fail "design-system path is not a directory: $host_dir"
    source_dir=$(CDPATH='' cd -- "$host_dir" 2>/dev/null && pwd -P) ||
        fail "cannot resolve design-system path: $host_dir"
    [ "$source_dir" != / ] || fail "refusing to import filesystem root"

    need_command tar
    require_running_container
    import_tmp=$(docker exec "$CONTAINER" mktemp -d '/tmp/open-design-import.XXXXXX') ||
        fail "cannot create container import directory"
    case $import_tmp in
        /tmp/open-design-import.*) ;;
        *) import_tmp=; fail "container returned unsafe import directory" ;;
    esac
    trap 'cleanup_import' EXIT HUP INT TERM

    if ! tar -C "$source_dir" -cf - . |
        docker exec -i "$CONTAINER" tar -xf - -C "$import_tmp"; then
        fail "failed to stream design-system package into container"
    fi

    status=0
    docker exec -i "$CONTAINER" node "$CLI_PATH" \
        design-systems import-local "$import_tmp" "$@" \
        --import-mode hybrid --daemon-url "$DAEMON_URL" || status=$?
    cleanup_import
    trap - EXIT HUP INT TERM
    return "$status"
}

in_container() {
    docker exec -i "$CONTAINER" "$@"
}

cleanup_sync() {
    case $sync_tmp in
        /tmp/open-design-sync.*)
            in_container rm -rf "$sync_tmp" >/dev/null 2>&1 || :
            ;;
    esac
    sync_tmp=
}

release_lock() {
    case $sync_lock in
        /tmp/open-design-sync-lock.*)
            in_container rm -rf "$sync_lock" >/dev/null 2>&1 || :
            ;;
    esac
    sync_lock=
}

# Undo everything this run changed, in reverse order, then release the lock.
# Called on any failure once the package has started replacing the installed
# one, and from the EXIT/signal trap.
rollback_sync() {
    if [ -n "$sync_link_created" ]; then
        # Remove the catalog entry through the API, not by deleting the
        # symlink: the daemon also holds a workspace binding for an installed
        # design system, and unlinking behind its back would leave that behind.
        if in_container_delete_design_system "$sync_id"; then
            sync_link_created=
        else
            printf '%s: warning: could not remove the catalog entry user:%s; leaving the installed package in place\n' \
                "$PROGRAM" "$sync_id" >&2
            # Removing the source now would leave the catalog pointing at
            # nothing, which is worse than a package that is merely newer than
            # intended. Keep it and let a human decide.
            sync_link_created=
            sync_backup=
            release_lock
            cleanup_sync
            return
        fi
    fi
    if [ -n "$sync_backup" ]; then
        # shellcheck disable=SC2016  # $1/$2 are the container shell's positional args
        in_container sh -c '
            set -eu
            rm -rf "$1"
            if [ -d "$2" ]; then mv "$2" "$1"; fi
        ' _ "$SOURCES_DIR/$sync_id" "$sync_backup" >/dev/null 2>&1 || :
        sync_backup=
    fi
    release_lock
    cleanup_sync
}

sync_fail() {
    rollback_sync
    trap - EXIT HUP INT TERM
    fail "$*"
}

in_container_delete_design_system() {
    need_command curl
    curl --fail --silent --show-error --max-time 30 \
        -X DELETE "$DAEMON_URL/api/design-systems/user:$1" >/dev/null 2>&1
}

# Read one string field out of a JSON file using the container's own node, so
# the bridge needs no jq on the host and no JSON parsing in shell.
read_manifest_field() {
    in_container node -e '
        const fs = require("fs");
        const value = JSON.parse(fs.readFileSync(process.argv[1], "utf8"))[process.argv[2]];
        process.stdout.write(typeof value === "string" ? value : "");
    ' "$1" "$2"
}

sync_package() {
    [ "$#" -eq 1 ] || fail "usage: open-design sync-package <package-dir>"
    host_dir=$1
    [ -n "$host_dir" ] || fail "package path must not be empty"
    [ -d "$host_dir" ] || fail "package path is not a directory: $host_dir"
    source_dir=$(CDPATH='' cd -- "$host_dir" 2>/dev/null && pwd -P) ||
        fail "cannot resolve package path: $host_dir"
    [ "$source_dir" != / ] || fail "refusing to sync the filesystem root"
    for required in manifest.json DESIGN.md tokens.css; do
        [ -f "$source_dir/$required" ] ||
            fail "not a design-system package: $source_dir/$required is missing"
    done

    need_command tar
    require_running_container

    sync_tmp=$(in_container mktemp -d '/tmp/open-design-sync.XXXXXX') ||
        fail "cannot create container staging directory"
    case $sync_tmp in
        /tmp/open-design-sync.*) ;;
        *) sync_tmp=; fail "container returned an unsafe staging directory" ;;
    esac
    trap 'rollback_sync' EXIT HUP INT TERM

    tar -C "$source_dir" -cf - . | in_container tar -xf - -C "$sync_tmp" ||
        sync_fail "failed to stream the package into the container"

    schema=$(read_manifest_field "$sync_tmp/manifest.json" schemaVersion) ||
        sync_fail "cannot read manifest.json"
    [ "$schema" = od-design-system-project/v1 ] ||
        sync_fail "unsupported manifest schemaVersion: ${schema:-<missing>}"
    sync_id=$(read_manifest_field "$sync_tmp/manifest.json" id) ||
        sync_fail "cannot read manifest.json"
    case $sync_id in
        '' | *[!0-9a-z-]* | -* | *- )
            sync_fail "unsafe design-system id in manifest.json: ${sync_id:-<missing>}"
            ;;
    esac

    # One writer per design system. mkdir is atomic, so two concurrent runs
    # cannot both pass this point and race over the same source directory,
    # backup and catalog entry. The lock lives in the container's /tmp, so a
    # container restart clears any lock a killed run left behind.
    sync_lock=/tmp/open-design-sync-lock.$sync_id
    in_container mkdir "$sync_lock" >/dev/null 2>&1 || {
        sync_lock=
        sync_fail "another sync-package run holds the lock for \"$sync_id\" (clear $CONTAINER:/tmp/open-design-sync-lock.$sync_id if no run is active)"
    }

    # Refuse anything this command did not install: an unrelated design system
    # of the same name must never be silently replaced.
    # shellcheck disable=SC2016  # the probe runs in the container; host expansion would be wrong
    state=$(in_container sh -c '
        set -eu
        src="$1/$3"
        link="$2/$3"
        marker="$src/$4"
        if [ -e "$src" ] || [ -L "$src" ]; then
            if [ ! -d "$src" ] || [ ! -f "$marker" ]; then echo foreign-source; exit 0; fi
        fi
        if [ -L "$link" ]; then
            target=$(readlink "$link")
            if [ "$target" != "$src" ]; then echo foreign-link; exit 0; fi
            echo update
            exit 0
        fi
        if [ -e "$link" ]; then echo foreign-link; exit 0; fi
        echo install
    ' _ "$SOURCES_DIR" "$CATALOG_DIR" "$sync_id" "$SYNC_MARKER") ||
        sync_fail "cannot inspect installed design systems"

    case $state in
        foreign-source)
            sync_fail "$SOURCES_DIR/$sync_id exists and was not installed by this command"
            ;;
        foreign-link)
            sync_fail "a different design system is already installed as \"$sync_id\""
            ;;
        install | update) ;;
        *) sync_fail "unexpected install state: $state" ;;
    esac

    # Name the backup after this run, so a crashed earlier run can never have
    # left one that this run would delete.
    sync_backup=$SOURCES_DIR/.backup-$sync_id-${sync_tmp##*.}
    # shellcheck disable=SC2016  # same: container-side positional args, not host variables
    in_container sh -c '
        set -eu
        mkdir -p "$1"
        rm -rf "$4"
        if [ -d "$1/$3" ]; then mv "$1/$3" "$4"; fi
        mv "$2" "$1/$3"
        printf "{\"managedBy\":\"open-design sync-package\",\"id\":\"%s\"}\n" "$3" > "$1/$3/$5"
    ' _ "$SOURCES_DIR" "$sync_tmp" "$sync_id" "$sync_backup" "$SYNC_MARKER" ||
        sync_fail "failed to install the package into $SOURCES_DIR"
    sync_tmp=

    if [ "$state" = install ]; then
        need_command curl
        curl --fail --silent --show-error --max-time 30 \
            -H 'Content-Type: application/json' \
            -d "{\"source\":\"local\",\"path\":\"$SOURCES_DIR/$sync_id\"}" \
            "$DAEMON_URL/api/design-systems/install" >/dev/null ||
            sync_fail "OpenDesign refused to install the package"
        sync_link_created=1
    fi

    in_container node "$CLI_PATH" design-systems show "user:$sync_id" \
        --daemon-url "$DAEMON_URL" >/dev/null ||
        sync_fail "the installed package did not validate; previous state restored"

    in_container rm -rf "$sync_backup" >/dev/null 2>&1 || :
    sync_backup=
    sync_link_created=
    release_lock
    trap - EXIT HUP INT TERM
    printf '%s: %s user:%s\n' "$PROGRAM" "$state" "$sync_id"
}

print_help() {
    cat <<'EOF'
Usage: open-design <command> [args]

Commands:
  install                      Build the local image and start OpenDesign.
  build                        Build the local image from the pinned base digest.
  start                        Create/start the service and wait until healthy.
  stop                         Stop the container; keep container and data.
  down                         Remove the container/network; keep both named volumes.
  restart                      Recreate the container and wait until healthy.
  status                       Show Compose service status.
  logs [compose log args]       Show service logs.
  open                         Open http://127.0.0.1:7456 in the browser.
  health                       Read the unauthenticated health endpoint.
  version                      Read the unauthenticated version endpoint.
  cli <od args>                Run the bundled OpenDesign CLI against the daemon.
  import-design-system <dir>   Run OpenDesign's own local importer on a folder.
  sync-package <dir>           Install/update a finished design-system package.
  help                         Show this help.

The open-design-mcp symlink launches only the quiet stdio MCP bridge.
EOF
}

if [ "$PROGRAM" = open-design-mcp ]; then
    [ "$#" -eq 0 ] || fail "the MCP bridge accepts no arguments"
    require_running_container
    run_mcp_bridge
    exit $?
fi

command=${1:-help}
[ "$#" -eq 0 ] || shift

case $command in
    install)
        [ "$#" -eq 0 ] || fail "install accepts no arguments"
        build_image
        compose up -d --no-build --pull never --wait
        ;;
    build)
        [ "$#" -eq 0 ] || fail "build accepts no arguments"
        build_image
        ;;
    start)
        [ "$#" -eq 0 ] || fail "start accepts no arguments"
        compose up -d --no-build --pull never --wait
        ;;
    stop)
        [ "$#" -eq 0 ] || fail "stop accepts no arguments"
        compose stop
        ;;
    down)
        [ "$#" -eq 0 ] || fail "down accepts no arguments"
        compose down --remove-orphans
        ;;
    restart)
        [ "$#" -eq 0 ] || fail "restart accepts no arguments"
        compose up -d --no-build --pull never --force-recreate --wait
        ;;
    status)
        [ "$#" -eq 0 ] || fail "status accepts no arguments"
        compose ps
        ;;
    logs)
        compose logs "$@"
        ;;
    open)
        [ "$#" -eq 0 ] || fail "open accepts no arguments"
        if command -v open >/dev/null 2>&1; then
            open "$DAEMON_URL"
        elif command -v xdg-open >/dev/null 2>&1; then
            xdg-open "$DAEMON_URL"
        else
            fail "no browser opener found (open or xdg-open)"
        fi
        ;;
    health)
        [ "$#" -eq 0 ] || fail "health accepts no arguments"
        need_command curl
        curl --fail --silent --show-error --max-time 10 "$DAEMON_URL/api/health"
        ;;
    version)
        [ "$#" -eq 0 ] || fail "version accepts no arguments"
        need_command curl
        curl --fail --silent --show-error --max-time 10 "$DAEMON_URL/api/version"
        ;;
    cli)
        [ "$#" -gt 0 ] || fail "usage: open-design cli <od args>"
        run_cli "$@"
        ;;
    import-design-system)
        import_design_system "$@"
        ;;
    sync-package)
        sync_package "$@"
        ;;
    help|-h|--help)
        [ "$#" -eq 0 ] || fail "help accepts no arguments"
        print_help
        ;;
    *)
        fail "unknown command: $command (run open-design help)"
        ;;
esac

#!/bin/sh
# Run the current Muse launcher with a separate login, settings and trust.
# Other tools keep their normal ~/.config entries through refreshed symlinks.
set -eu

if ! command -v muse >/dev/null 2>&1; then
    printf 'muse2: muse is not on PATH; install Muse Code first\n' >&2
    exit 127
fi

muse2_config=$HOME/.config-muse2
normal_config=$HOME/.config
# A linked root or Muse directory could send login writes to account 1.
if [ -L "$muse2_config" ] || [ -L "$muse2_config/muse" ]; then
    printf 'muse2: account config root and muse directory must not be symlinks\n' >&2
    exit 1
fi
mkdir -p "$muse2_config/muse"

# Include hidden entries and dangling links; leave all existing destinations.
for entry in "$normal_config"/* "$normal_config"/.[!.]* "$normal_config"/..?*; do
    [ -e "$entry" ] || [ -L "$entry" ] || continue
    name=${entry##*/}
    [ "$name" != muse ] || continue
    link=$muse2_config/$name
    if [ ! -e "$link" ] && [ ! -L "$link" ]; then
        # Target the root directory so a concurrent link cannot be followed.
        if ! ln -s "$entry" "$muse2_config/" 2>/dev/null; then
            [ -e "$link" ] || [ -L "$link" ] || {
                printf 'muse2: cannot link config entry: %s\n' "$entry" >&2
                exit 1
            }
        fi
    fi
done

XDG_CONFIG_HOME=$muse2_config
export XDG_CONFIG_HOME
# The upstream launcher uses this optional override for download authentication.
unset MUSE_AUTH_PATH
exec muse "$@"
